generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  createdAt DateTime @default(now())
  password String
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  price       Float
  quantity    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Drink {
  id          Int      @id @default(autoincrement())
  name        String
  category    String   // Ex: "Refrigerante", "Suco", "Vinho", etc.
  quantity    Int      @default(0)
  minQuantity Int      @default(0) // quantidade mínima definida pelo usuário
  status      String   @default("ok") // ok, fazer_pedido, esgotado
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
